# TN Traffic Intelligence - 配置样例（不含任何密钥，可直接复制为 .env 或设为环境变量）

# ---- 服务监听 ----
TN_HOST=127.0.0.1
TN_PORT=8077

# ---- 数据与工件目录 ----
# 原始数据必须放在 <TN_DATA_DIR>/raw 下的六个文件（文件名不可改）
TN_DATA_DIR=E:\codex\codex10.16\data
TN_DB_PATH=E:\codex\codex10.16\data\tn_traffic.db

# ---- 预训练权重缓存 ----
TN_MODEL_CACHE=E:\codex\codex10.16\models_cache
# 官方 huggingface.co 在部分网络不可达；默认使用官方镜像，也可填自建代理
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=E:\codex\codex10.16\models_cache\hf
# 若已有 HuggingFace 访问令牌（下载受限仓库时才需要），在此填写
# HF_TOKEN=

# ---- Worker ----
TN_WORKER_POLL=0.75
TN_WORKER_STALE=120

# ---- 前端（可选）----
# 前端开发模式代理的后端地址
TN_BACKEND=http://127.0.0.1:8077
# 生产构建下若前端与后端不同源，可指定 API 基地址
# VITE_API_BASE=
